# Notion Integration Token
# https://www.notion.so/my-integrations 에서 발급
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 데이터베이스 ID
# 데이터베이스 URL: https://www.notion.so/{workspace}/{DATABASE_ID}?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 매일 업데이트 실행 시각 (24시간, 서버 로컬 시간 기준)
SCHEDULE_TIME=09:00
